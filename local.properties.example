# Copy to local.properties and fill machine/app-specific values. Do not commit local.properties.
sdk.dir=/absolute/path/to/Android/Sdk

# React app loaded by the Android WebView shell.
VECTOR_WEB_URL=https://app.projectvector.ai

# Comma-separated HTTPS hosts allowed inside the WebView.
VECTOR_TRUSTED_HOSTS=app.projectvector.ai,projectvector.ai

# OAuth 2.0 Web client ID used by Android Credential Manager / Google ID token flow.
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Backend endpoint that exchanges a Google ID token for app session tokens.
VECTOR_AUTH_EXCHANGE_URL=https://api.projectvector.ai/auth/google
